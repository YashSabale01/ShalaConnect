        </mxCell>

        <mxCell id="u-hm" value="School Headmasters&#xa;(Mobile / Offline Queue)" style="shape=mxgraph.aws4.user;fillColor=#16a34a;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="users-group">
          <mxGeometry x="60" y="180" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u-pub" value="General Public &amp; Parents&#xa;(School Directory Search)" style="shape=mxgraph.aws4.user;fillColor=#d97706;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="users-group">
