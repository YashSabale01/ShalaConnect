        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ROUTE 53 & CLOUDFRONT -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="dns-cf-group" value="Edge &amp; DNS Layer" style="shape=mxgraph.aws4.group;strokeColor=#d97706;fillColor=#fffbeb;verticalAlign=top;align=center;spacingTop=15;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="100" width="220" height="480" as="geometry" />
        </mxCell>

        <mxCell id="r53" value="Amazon Route 53&#xa;shalaconnect.in&#xa;(DNS Routing)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;fillColor=#8C4FFF;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="dns-cf-group">
          <mxGeometry x="75" y="50" width="70" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cf" value="AWS CloudFront CDN&#xa;• Global TLS 1.3 Termination&#xa;• Edge Caching&#xa;• SPA Error Fallback (/index.html)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;fillColor=#8C4FFF;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="dns-cf-group">
          <mxGeometry x="75" y="240" width="70" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e-r53-cf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" source="r53" target="cf" parent="dns-cf-group">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- Connect Users to Route 53 -->
        <mxCell id="e-u-r53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" source="users-group" target="r53" parent="1">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- S3 FRONTEND BUCKET -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="s3-front" value="Amazon S3 (Frontend Bucket)&#xa;shalaconnect-frontend&#xa;• React 18 + Vite SPA&#xa;• Origin Access Control (OAC)&#xa;• Zero Public Access" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#16a34a;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- CloudFront -> S3 Frontend -->
        <mxCell id="e-cf-s3" value="Path: /*&#xa;(Static Files)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;fontSize=10;fontStyle=1;" edge="1" source="cf" target="s3-front" parent="1">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- AWS VPC -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="vpc" value="Amazon VPC (10.0.0.0/16) — Region: ap-south-1 (Mumbai)" style="shape=mxgraph.aws4.group;strokeColor=#0284c7;fillColor=#f0f9ff;verticalAlign=top;align=center;spacingTop=20;fontSize=13;fontStyle=1;" vertex="1" parent="1">
