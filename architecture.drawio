        </mxCell>

        <!-- Public Subnets -->
        <mxCell id="pub-sub" value="Public Subnets (10.0.1.0/24 &amp; 10.0.2.0/24)" style="shape=mxgraph.aws4.group;strokeColor=#0284c7;fillColor=#e0f2fe;verticalAlign=top;align=center;spacingTop=15;fontSize=11;fontStyle=1;" vertex="1" parent="vpc">
          <mxGeometry x="20" y="40" width="780" height="150" as="geometry" />
        </mxCell>

        <mxCell id="alb" value="Application Load Balancer (ALB)&#xa;Port 80/443 Ingress&#xa;Health Check: /api/health&#xa;Target Group :8080" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;fillColor=#0284c7;strokeColor=none;fontSize=10;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="pub-sub">
          <mxGeometry x="120" y="35" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="nat" value="NAT Gateway + EIP&#xa;(Outbound Internet for Private Tasks)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;fillColor=#0284c7;strokeColor=none;fontSize=10;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="pub-sub">
          <mxGeometry x="540" y="35" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- CloudFront -> ALB -->
        <mxCell id="e-cf-alb" value="Path: /api/* &amp; /uploads/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0284c7;strokeWidth=2;fontSize=10;fontStyle=1;" edge="1" source="cf" target="alb" parent="1">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- Private Subnets -->
        <mxCell id="priv-sub" value="Private Subnets (10.0.10.0/24 &amp; 10.0.11.0/24) — Zero Direct Inbound Internet" style="shape=mxgraph.aws4.group;strokeColor=#475569;fillColor=#f1f5f9;verticalAlign=top;align=center;spacingTop=15;fontSize=11;fontStyle=1;" vertex="1" parent="vpc">
          <mxGeometry x="20" y="210" width="780" height="340" as="geometry" />
        </mxCell>

        <!-- ECS Fargate -->
        <mxCell id="ecs-cluster" value="AWS ECS Fargate Cluster&#xa;(shalaconnect-prod-cluster)" style="shape=mxgraph.aws4.group;strokeColor=#ea580c;fillColor=#fff7ed;verticalAlign=top;align=center;spacingTop=15;fontSize=11;fontStyle=1;" vertex="1" parent="priv-sub">
          <mxGeometry x="30" y="40" width="340" height="260" as="geometry" />
        </mxCell>

        <mxCell id="ecs-task" value="Spring Boot 21 Backend Task&#xa;• Embedded Tomcat :8080&#xa;• JWT Stateless Authentication&#xa;• Apache POI Report Generator&#xa;• Bidirectional Notifications" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fillColor=#ea580c;strokeColor=none;fontSize=10;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="ecs-cluster">
          <mxGeometry x="130" y="60" width="70" height="70" as="geometry" />
        </mxCell>

        <!-- ALB -> ECS Task -->
        <mxCell id="e-alb-ecs" value="Forward :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ea580c;strokeWidth=2;fontSize=10;fontStyle=1;" edge="1" source="alb" target="ecs-task" parent="vpc">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- RDS PostgreSQL -->
        <mxCell id="rds-group" value="Amazon RDS PostgreSQL 16&#xa;(Multi-AZ / Graviton ARM)" style="shape=mxgraph.aws4.group;strokeColor=#dc2626;fillColor=#fef2f2;verticalAlign=top;align=center;spacingTop=15;fontSize=11;fontStyle=1;" vertex="1" parent="priv-sub">
          <mxGeometry x="410" y="40" width="340" height="260" as="geometry" />
        </mxCell>

        <mxCell id="rds" value="PostgreSQL 16 DB&#xa;school_management&#xa;• Port 5432 (from ECS only)&#xa;• Encrypted Storage (KMS)&#xa;• Automated 7-day Backups" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;fillColor=#dc2626;strokeColor=none;fontSize=10;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="rds-group">
          <mxGeometry x="135" y="60" width="70" height="70" as="geometry" />
        </mxCell>

        <!-- ECS -> RDS -->
        <mxCell id="e-ecs-rds" value="SQL Query :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#dc2626;strokeWidth=2;fontSize=10;fontStyle=1;" edge="1" source="ecs-task" target="rds" parent="priv-sub">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- ECS -> NAT -->
        <mxCell id="e-ecs-nat" value="Outbound HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748b;strokeWidth=1;dashed=1;fontSize=9;" edge="1" source="ecs-task" target="nat" parent="vpc">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- S3 UPLOADS BUCKET -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="s3-uploads" value="Amazon S3 (Uploads Bucket)&#xa;shalaconnect-uploads&#xa;• GR Circular PDFs&#xa;• Event Implementation Photos&#xa;• AES-256 Server-Side Encryption" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#16a34a;strokeColor=none;fontSize=11;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1400" y="470" width="80" height="80" as="geometry" />
        </mxCell>

        <!-- ECS -> S3 Uploads -->
        <mxCell id="e-ecs-s3up" value="Put / Get Files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=2;fontSize=10;fontStyle=1;" edge="1" source="ecs-task" target="s3-uploads" parent="1">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- CI/CD PIPELINE (GITHUB ACTIONS) -->
        <!-- ═══════════════════════════════════════════════════ -->
        <mxCell id="cicd-group" value="Automated CI/CD Pipeline (GitHub Actions)" style="shape=mxgraph.aws4.group;strokeColor=#1e293b;fillColor=#f8fafc;verticalAlign=top;align=center;spacingTop=15;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="450" height="240" as="geometry" />
        </mxCell>

        <mxCell id="gh" value="GitHub Repository&#xa;YashSabale01/ShalaConnect&#xa;(branch: main)" style="shape=mxgraph.veeam2.github;fillColor=#0f172a;strokeColor=none;fontSize=10;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="cicd-group">
          <mxGeometry x="30" y="50" width="55" height="55" as="geometry" />
        </mxCell>

        <mxCell id="gha" value="GitHub Actions Workflow&#xa;(.github/workflows/deploy.yml)&#xa;• Job 1: Build Docker → ECR → ECS&#xa;• Job 2: Build Vite → S3 → CloudFront" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;fillColor=#2563eb;strokeColor=none;fontSize=10;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="cicd-group">
          <mxGeometry x="190" y="50" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ecr" value="Amazon ECR&#xa;shalaconnect-backend&#xa;(Container Registry)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;fillColor=#ea580c;strokeColor=none;fontSize=10;fontStyle=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="cicd-group">
          <mxGeometry x="350" y="50" width="60" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e-gh-gha" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0f172a;strokeWidth=2;" edge="1" source="gh" target="gha" parent="cicd-group">
          <mxGeometry as="geometry" />
        </mxCell>

        <mxCell id="e-gha-ecr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ea580c;strokeWidth=2;" edge="1" source="gha" target="ecr" parent="cicd-group">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- GHA -> S3 Frontend -->
        <mxCell id="e-gha-s3" value="aws s3 sync dist/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16a34a;strokeWidth=1;dashed=1;fontSize=9;" edge="1" source="gha" target="s3-front" parent="1">
          <mxGeometry as="geometry" />
        </mxCell>

        <!-- ECR -> ECS Fargate -->
        <mxCell id="e-ecr-ecs" value="Pull Image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ea580c;strokeWidth=1;dashed=1;fontSize=9;" edge="1" source="ecr" target="ecs-task" parent="1">
