# Backend Environment Variables
# Copy this file to .env and fill in values before running

PORT=8080

# PostgreSQL Database (use AWS RDS endpoint in production)
DB_URL=jdbc:postgresql://localhost:5432/school_management
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# JWT (must be at least 32 characters long)
JWT_SECRET=shalaconnect_super_secret_jwt_key_must_be_at_least_32_chars!!
JWT_EXPIRATION=604800000

# File uploads directory
UPLOAD_DIR=uploads

# Admin seed account
ADMIN_EMAIL=admin@shalaconnect.in
ADMIN_PASSWORD=Admin@123

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
